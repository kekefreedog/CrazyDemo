{{!-- Root --}}
<div id="crazy-root" descriptive-id="" class="screen-fit-min-y screen-flex screen-center">

    {{> preloader_linear_indeterminate}}

    {{> navigation}}

    {{!-- Body --}}
    <div id="crazy-content" descriptive-id="" class="element-flex-grow-1 pb-5">

        <div class="row container">

            <div class="col s12 row">

                {{!-- Title --}}
                <div class="col s12">
                    <h1>Crazy Fitler</h1>
                </div>

                {{!-- Form --}}
                <div class="col s12">
                    <h4>Filter</h4>
                </div>
                
                {{!-- Simple Form --}}
                <div class="col s6 m6">
                    <h5>Simple Filter</h5>
                    {{> form form=@root._ui.forms.simple_filter}}
                </div>

            </div>

        </div>

    </div>

</div>
